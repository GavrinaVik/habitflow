# ============================================================
# HabitFlow — переменные окружения
# Скопируйте в .env (локально) или в настройки деплоя.
# Ничего из перечисленного не обязано существовать для локального
# запуска — сервер работает на моках со значениями по умолчанию.
# ============================================================

# --- Сервер ---
NODE_ENV=development
PORT=3001
# Разрешённые Origin для CORS (через запятую). В проде — URL фронтенда.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Безопасность / auth ---
# Секрет подписи JWT. В проде — обязателен и НЕ должен совпадать с дефолтом!
JWT_SECRET=habitflow-dev-secret-change-me

# --- ЮKassa (тестовый режим shopId/secret) ---
YUKASSA_SHOP_ID=
YUKASSA_SECRET_KEY=

# --- Unisender ---
UNISENDER_API_KEY=

# --- Google Calendar (OAuth 2.0) ---
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# --- Яндекс.Метрика ---
YANDEX_METRIKA_ID=98765432

# --- База данных (следующий этап: Supabase/PostgreSQL) ---
# DATABASE_URL=postgres://user:pass@host:5432/habitflow